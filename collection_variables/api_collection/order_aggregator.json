    {
      "name": "Create Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Get the current date and time\r",
              "const currentDate = new Date();\r",
              "\r",
              "// Format the date and time as \"YYYY-MM-DD HH:mm:ss\"\r",
              "const formattedDateTime = `${currentDate.getFullYear()}-${(currentDate.getMonth() + 1).toString().padStart(2, '0')}-${currentDate.getDate().toString().padStart(2, '0')} ${currentDate.getHours().toString().padStart(2, '0')}:${currentDate.getMinutes().toString().padStart(2, '0')}:${currentDate.getSeconds().toString().padStart(2, '0')}`;\r",
              "\r",
              "// Set the formatted date and time to a collection variable\r",
              "pm.collectionVariables.set(\"formattedDateTime\", formattedDateTime);\r",
              "console.log(\"Formatted Date and Time:\", formattedDateTime);\r",
              "\r",
              "\r",
              "// Generate a random or_number (a 10-digit random number)\r",
              "let or_number = Math.floor(1000000000 + Math.random() * 9000000000);  // Generates a 10-digit random number\r",
              "// Save this or_number as a collection variable\r",
              "pm.collectionVariables.set(\"or_number\", or_number);\r",
              "// Log the or_number to Postman's console for debugging (optional)\r",
              "console.log(\"Generated OR Number:\", or_number);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code: \" + pm.response.code, function(){\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "let responsedata = pm.response.json();\r",
              "\r",
              "let cart_id_data = responsedata.data[0].cart_id;\r",
              "pm.collectionVariables.set(\"cart_id\", cart_id_data);\r",
              "\r",
              "let item_id_data = responsedata.data[0].items[0].item_id;\r",
              "pm.collectionVariables.set(\"item_id\", item_id_data);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],

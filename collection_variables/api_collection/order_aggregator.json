    {
      "name": "Employee Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Generate a random UUID\r",
              "const randomUUID = generateUUID();\r",
              "function generateUUID() {\r",
              "    let uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\r",
              "        let r = Math.random() * 16 | 0,\r",
              "            v = c == 'x' ? r : (r & 0x3 | 0x8);\r",
              "        return v.toString(16);\r",
              "    });\r",
              "    return uuid;\r",
              "}\r",
              "\r",
              "// Generate a random number between 1000 and 9999 for a dynamic number\r",
              "const randomNumber = Math.floor(Math.random() * 9000) + 1000;\r",
              "\r",
              "let responseJson = pm.response.json();\r",
              "pm.collectionVariables.set(\"ACCESS_TOKEN\", \"Bearer \" + responseJson.data.AccessToken);\r",
              "pm.collectionVariables.set(\"random_uuid\", randomUUID);\r",
              "pm.collectionVariables.set(\"random_number\", randomNumber.toString());\r",
              "\r",
              "pm.test(\"Status code: \" + pm.response.code, function(){\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let responsedata = pm.response.json();\r",
              "let employee_id_data = responsedata.data.employee_id;\r",
              "pm.collectionVariables.set(\"employee_id\", employee_id_data);\r",
              "\r",
              "let access_code_data = responsedata.data.access_code;\r",
              "pm.collectionVariables.set(\"access_code\", access_code_data);\r",
              "\r",
              "let first_name_data = responsedata.data.first_name;\r",
              "pm.collectionVariables.set(\"first_name\", first_name_data);\r",
              "\r",
              "let last_name_data = responsedata.data.last_name;\r",
              "pm.collectionVariables.set(\"last_name\", last_name_data);\r",
              "\r",
              "let _id_data = responsedata.data._id;\r",
              "pm.collectionVariables.set(\"_id\", _id_data);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],

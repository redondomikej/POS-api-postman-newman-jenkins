		{
			"name": "Employee Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Generate a random UUID\r",
							"const randomUUID = generateUUID();\r",
							"function generateUUID() {\r",
							"    let uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\r",
							"        let r = Math.random() * 16 | 0,\r",
							"            v = c == 'x' ? r : (r & 0x3 | 0x8);\r",
							"        return v.toString(16);\r",
							"    });\r",
							"    return uuid;\r",
							"}\r",
							"\r",
							"// Generate a random number between 1000 and 9999 for a dynamic number\r",
							"const randomNumber = Math.floor(Math.random() * 9000) + 1000;\r",
							"\r",
							"pm.test(\"Status code: \" + pm.response.code, function(){\r",
							"    pm.response.to.have.status(200);\r",
							"\r",
							"});\r",
							"\r",
							"    pm.collectionVariables.set(\"ACCESS_TOKEN\", \"Bearer \" + pm.response.json().data.AccessToken);\r",
							"pm.collectionVariables.set(\"random_uuid\", randomUUID);\r",
							"pm.collectionVariables.set(\"random_number\", randomNumber.toString());\r",
							"\r",
							"pm.collectionVariables.set(\"employee_id\", pm.response.json().data.employee_id);\r",
							"\r",
							"pm.collectionVariables.set(\"access_code\", pm.response.json().data.access_code);\r",
							"\r",
							"pm.collectionVariables.set(\"first_name\", pm.response.json().data.first_name);\r",
							"\r",
							"pm.collectionVariables.set(\"last_name\", pm.response.json().data.last_name);\r",
							"\r",
							"pm.collectionVariables.set(\"_id\", pm.response.json().data._id);\r",
							"\r",
							"pm.collectionVariables.set(\"merchant\", pm.response.json().data.merchant);\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "{{MERCHANT_ACCESS_TOKEN}}"
					}

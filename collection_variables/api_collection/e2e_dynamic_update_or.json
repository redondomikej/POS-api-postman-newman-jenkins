							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response Time: \" + pm.response.responseTime + \" ms\", function(){\r",
							"    pm.expect(responseTime).to.be.above(0);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"var isTestPassed = false;\r",
							"\r",
							"pm.test(\"Get Products\", function () {\r",
							"    try {\r",
							"        pm.expect(jsonData).to.have.property(\"statusCode\", 200);\r",
							"       \r",
							"        isTestPassed = true;\r",
							"    } catch (e) {\r",
							"        console.log('The assertion failed');\r",
							"        throw e;\r",
							"    }    \r",
							"});\r",
